# --- App -------------------------------------------------------------------
APP_NAME=AI IELTS Examiner API
# development | production
APP_ENV=development
# URL of the deployed frontend (used for CORS and verification links)
FRONTEND_URL=http://localhost:4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4000,http://localhost:3000
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Security --------------------------------------------------------------
# Generate a long random string for production: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# --- Rate limiting (per IP, per 5 minutes) ----------------------------------
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_VERIFY_MAX=10
RATE_LIMIT_WINDOW_SECONDS=300

# --- Database --------------------------------------------------------------
# Supabase pooler (IPv4) example:
# postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://ielts:ielts_secret@localhost:5432/ielts

# --- AI provider (Groq primary, Gemini fallback) ---------------------------
# Get a free key at https://console.groq.com/keys (no card required)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# Get a key at https://aistudio.google.com/apikey (paid quota recommended)
USE_GEMINI=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# --- Email (verification + password reset) -----------------------------------
# Any SMTP provider works. Recommended: Resend (https://resend.com)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxxxxxx
# SMTP_FROM=AI IELTS <no-reply@yourdomain.com>
# SMTP_USE_TLS=true
# When SMTP_HOST is empty the API falls back to development mode: the 6-digit
# verification code is returned in the API response and shown in the UI.
